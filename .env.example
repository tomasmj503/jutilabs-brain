# ===== jutilabs-brain =====
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Supabase (proyecto NUEVO, aislado de proyectos personales) — service role, nunca anon
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Redis (en Docker: redis://:PASSWORD@redis:6379 ; local: redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# Chatwoot
CHATWOOT_BASE_URL=https://chat.jutilabs.com
CHATWOOT_WEBHOOK_SECRET=            # valor que tú defines; se compara con header X-Jutilabs-Secret
# Token de acceso de la cuenta de Chatwoot por cliente: se referencia por nombre desde clientes.chatwoot_token_ref
CHATWOOT_TOKEN_MANDALA=
CHATWOOT_TOKEN_PRUEBAS=

# OpenRouter — UNA clave por cliente con tope de gasto. clientes.openrouter_key_ref = nombre de la variable
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_KEY_MANDALA=
OPENROUTER_KEY_PRUEBAS=

# n8n — webhook para avisos al equipo (escalamiento, leads)
N8N_WEBHOOK_AVISOS=https://n8n.jutilabs.com/webhook/aviso-equipo
N8N_WEBHOOK_SECRET=

# Comportamiento
BUFFER_MS=8000
LOCK_TTL_MS=60000
