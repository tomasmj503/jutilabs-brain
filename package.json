{
  "name": "jutilabs-brain",
  "version": "0.1.0",
  "private": true,
  "description": "Cerebro conversacional multi-cliente de JUTILABS (WhatsApp/web vía Chatwoot)",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:regresion": "vitest run tests/regresion",
    "lint": "echo 'TODO: eslint' && exit 0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.0",
    "openai": "^4.60.0",
    "pino": "^9.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
