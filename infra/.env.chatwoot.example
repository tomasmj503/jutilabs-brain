# ===== infra/.env.chatwoot =====
SECRET_KEY_BASE=               # openssl rand -hex 64
FRONTEND_URL=https://chat.jutilabs.com
FORCE_SSL=true
DEFAULT_LOCALE=es
TZ=America/Bogota
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
ENABLE_ACCOUNT_SIGNUP=false     # multi-cuenta: las cuentas las crea el Super Admin, no el público

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=jutilabs      # = POSTGRES_USER de infra/.env
POSTGRES_PASSWORD=              # = POSTGRES_PASSWORD de infra/.env
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=                 # = REDIS_PASSWORD de infra/.env

ACTIVE_STORAGE_SERVICE=local
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# Correo — necesario para invitar agentes (Diego, Andrea +2) y recuperar contraseñas.
# Pendiente: proveedor SMTP. Sin esto, las invitaciones no llegan.
MAILER_SENDER_EMAIL=Chatwoot <chat@jutilabs.com>
SMTP_DOMAIN=jutilabs.com
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# WhatsApp Embedded Signup (Coexistence). §11.1: las credenciales de la app de Mandala se cargan en el
# panel de Super Admin. Algunas versiones también las leen de estas variables — verificar en la doc de la
# versión instalada antes de asumir cuál manda. Dejar vacías hasta tener la app creada.
# WHATSAPP_APP_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_CONFIGURATION_ID=
