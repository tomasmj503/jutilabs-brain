# ===== infra/.env — variables del compose (NO es el .env del brain, ese vive en la raíz) =====
# Generar contraseñas: openssl rand -hex 24
POSTGRES_USER=jutilabs
POSTGRES_PASSWORD=
N8N_DB_PASSWORD=
REDIS_PASSWORD=
N8N_ENCRYPTION_KEY=            # openssl rand -hex 32 — si se pierde, se pierden las credenciales guardadas en n8n

# Pinear versiones después del primer pull (docker image inspect). No dejar "latest" en producción.
CHATWOOT_VERSION=latest
N8N_VERSION=latest
