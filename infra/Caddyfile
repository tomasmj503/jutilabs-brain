# TLS automático (Let's Encrypt). Requiere DNS A de los subdominios → IP del servidor y dominio vigente.
{
  email admin@jutilabs.com
  servers {
    protocols h1 h2
  }
}

chat.jutilabs.com {
  reverse_proxy chatwoot-rails:3000
  encode gzip
}

n8n.jutilabs.com {
  # Editor abierto desde internet (decisión 16-oct): protegido por login de
  # n8n + doble factor obligatorio en todos los usuarios.
  reverse_proxy n8n:5678
}

api.jutilabs.com {
  # Solo lo necesario expuesto. Todo lo demás → 404.
  # /health/ready: para el monitor externo (no muestra datos de huéspedes).
  @permitido path /health /health/ready /webhook/*
  handle @permitido {
    reverse_proxy brain:8080
  }
  handle {
    respond 404
  }
}
